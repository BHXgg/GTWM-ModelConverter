<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GTWM Model Converter</AssemblyName>
    <RootNamespace>GTWM.ModelConverter</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationIcon />
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\build\ModelConverter\</OutputPath>
    <DebugType>embedded</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>GTWM Model Converter</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Compile against these, but ship them embedded in the exe (see Program.cs). -->
    <PackageReference Include="AssimpNet" Version="5.0.0-beta1" GeneratePathProperty="true" ExcludeAssets="runtime;native;build" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PkgAssimpNet)\lib\net40\AssimpNet.dll" LogicalName="lib.AssimpNet.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgAssimpNet)\runtimes\win-x64\native\assimp.dll" LogicalName="native.assimp.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgNewtonsoft_Json)\lib\net45\Newtonsoft.Json.dll" LogicalName="lib.Newtonsoft.Json.dll" Visible="false" />
  </ItemGroup>
</Project>
